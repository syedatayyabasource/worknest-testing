{
  "name":"worknest-testing-suite","version":"1.0.0","private":true,
  "scripts":{"dev":"concurrently \"npm run server:dev\" \"npm run client:dev\"","client:dev":"vite --config client/vite.config.js","server:dev":"node server/src/server.js","build":"vite build --config client/vite.config.js","test":"npm run test:frontend && npm run test:backend","test:frontend":"vitest run --config client/vitest.config.js","test:backend":"vitest run --config server/vitest.config.js","test:e2e":"playwright test","test:all":"npm test && npm run test:e2e","install:browsers":"playwright install"},
  "dependencies":{"cors":"^2.8.5","express":"^5.1.0","react":"^19.1.1","react-dom":"^19.1.1"},
  "devDependencies":{"@playwright/test":"^1.54.2","@testing-library/jest-dom":"^6.8.0","@testing-library/react":"^16.3.0","@testing-library/user-event":"^14.6.1","@vitejs/plugin-react":"^5.0.2","concurrently":"^9.2.1","jsdom":"^26.1.0","supertest":"^7.1.4","vite":"^7.1.2","vitest":"^3.2.4"}
}
